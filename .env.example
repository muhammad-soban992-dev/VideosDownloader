# Copy to .env and edit.  (.env is git/docker-ignored — never commit it.)

# Your domain (A record -> server IP), or <elastic-ip>.sslip.io if you have none.
DOMAIN=videos.example.com

# Signs download links. Generate with:  openssl rand -hex 32
URL_SECRET=change-me

# Simultaneous yt-dlp/ffmpeg jobs. 2-3 for a 2 GB server.
MAX_CONCURRENT_JOBS=2

# --- optional ---
# Per-IP requests per minute
# RATE_LIMIT_INFO=20
# RATE_LIMIT_STREAM=30
# Netscape cookies.txt (YouTube bot-check / login-only videos). See DEPLOY_AWS.md.
# COOKIES_FILE=/run/cookies.txt
# Residential/other proxy for yt-dlp, e.g. http://user:pass@host:port
# YTDLP_PROXY=
